{
  "name": "@meddleware/docs-site",
  "version": "0.0.49",
  "description": "Meddleware developer tools documentation site (docs.meddleware.co.uk) — VitePress. Blockchain-agnostic with Sui as the first active chain.",
  "homepage": "https://docs.meddleware.co.uk/",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/docs-site.git"
  },
  "type": "module",
  "files": [
    "docs",
    "!docs/audit",
    "!docs/audit/**",
    "scripts",
    "tsconfig.json",
    "tsconfig.typedoc.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "gen:onchain": "mw-gen-onchain",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:network": "mw-network-status --out docs/.vitepress/network.json",
    "dev": "npm run gen:api && npm run gen:onchain && vitepress dev docs",
    "build": "npm run gen:api && npm run gen:onchain && npm run check:onchain-ids && vitepress build docs && mw-gen-llms-full https://docs.meddleware.co.uk \"Meddleware documentation\" && mw-check-dist-no-audit",
    "check:csp": "mw-check-csp-inline @Dockerfile dist",
    "preview": "vitepress preview docs",
    "type-check": "tsc --noEmit",
    "lint:js": "eslint .",
    "lint": "npm run lint:js",
    "licenses": "mw-third-party-licenses",
    "check:licenses": "mw-third-party-licenses --check",
    "check:onchain-ids": "mw-check-onchain-ids",
    "check:network": "mw-network-status --check docs/.vitepress/network.json",
    "test": "vitest run",
    "shots": "SHOTS=1 playwright test",
    "test:e2e": "npm run build && playwright test",
    "lhci": "npm run build && lhci autorun"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/access-gate-client": "^0.0.13",
    "@meddleware/design-tokens": "^0.1.13",
    "@meddleware/sealed-storage-client": "^0.0.26",
    "@meddleware/ui": "^0.1.42",
    "@meddleware/vitepress-theme": "^0.0.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@meddleware/access-gate-gateway-client": "^0.0.22",
    "@meddleware/access-gate-sui": "^0.0.12",
    "@meddleware/frontend-config": "^0.0.8",
    "@meddleware/sealed-storage-sui": "^0.0.11",
    "@meddleware/token-issuance-template-sui": "^1.0.14",
    "@meddleware/walrus-storage-client": "^0.0.34",
    "@mysten/seal": "^1.5.0",
    "@mysten/sui": "^2.36.0",
    "@mysten/walrus": "~1.2.35",
    "@playwright/test": "~1.65.0",
    "@types/node": "~26.6.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "jiti": "^2.7.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~6.0.0",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "~5.1.0",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "extends @meddleware/frontend-config/browserslist-config"
  ],
  "overrides": {
    "basic-ftp": "^6.2.4",
    "tmp": "^0.2.7",
    "zod": "^4.6.7"
  },
  "meddleware": {
    "kind": "app",
    "csp": "docs",
    "lhci": true,
    "site": {
      "id": "docs",
      "outBase": "blockchain/sui/onchain",
      "otherSite": {
        "id": "dev",
        "origin": "https://meddleware.dev",
        "base": "sui/onchain"
      }
    },
    "onchainIds": {
      "required": {
        "blockchain/sui/access-gate/reference.md": [
          "accessGate.originalId",
          "accessGate.platformConfigId"
        ],
        "blockchain/sui/treasury/reference.md": [
          "accessGate.originalId",
          "accessGate.platformConfigId"
        ],
        "blockchain/sui/sealed-storage/reference.md": [
          "sealPolicies.originalId",
          "sealPolicies.policyConfigId"
        ]
      },
      "skipDirs": [
        "api",
        "wire-api"
      ]
    }
  }
}
